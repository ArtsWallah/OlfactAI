# OlfactAI Backend Configuration

# Application Settings
PROJECT_NAME="OlfactAI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Security & CORS
# Comma-separated list of origins or JSON array format
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Logging Settings
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# Chemistry Engine Settings
DEFAULT_MORGAN_RADIUS=2
DEFAULT_MORGAN_NBITS=2048
MAX_SMILES_LENGTH=1000

# File Paths (relative to backend or absolute)
MODELS_DIR="models"
DATASETS_DIR="datasets"

